+++
# One template, two mode-specific MAD launch commands. The bodies are
# identical BY GENERATION; everything that differs between the review and
# design invocations is bound below as a parameter:
#   referee       - the referee definition each command @-references
#   topics-dir    - where that referee's methodology topics live
#   mode-cap/mode - the Review/Design vocabulary threaded through the prose
#   charter-term  - what the free-form instruction text is called
#   suggest-tail  - the roster-widening rationale in "Seats are the
#                   invoker's call"
#   target-bullet - the one structurally different extraction bullet: review
#                   points at an extant artifact; design admits an existing
#                   brief OR an empty output location, in which case the
#                   referee elicits the problem statement interactively.
# No hand-authored frontmatter here: the command surface's generator
# machinery emits the minimal banner-only frontmatter block above this body.
[outputs.mad-review]
referee = "mad-review-referee.md"
topics-dir = "mad-review-topics"
mode-cap = "Review"
mode = "review"
charter-term = "charter"
suggest-tail = "the material rewards more independent looks"
target-bullet = "Path to the artifact under review (file or directory)"

[outputs.mad-design]
referee = "mad-design-referee.md"
topics-dir = "mad-design-topics"
mode-cap = "Design"
mode = "design"
charter-term = "brief"
suggest-tail = "the problem rewards more independent constructions"
target-bullet = "Path to the problem statement. Either (a) an existing brief defining the open problem (file or directory), or (b) an empty/not-yet-created output location — in case (b) the referee will elicit the problem statement from the user interactively before dispatching participants"
